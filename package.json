{
  "name": "pinchgrab",
  "description": "browser-side ui capture exports for review agents",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build-extension.ts",
    "watch": "bun run --watch scripts/build-extension.ts",
    "typecheck": "tsc --noEmit",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "test": "bun run build && bun run test:browsers && bun run test:static && bun run test:smoke && bun run test:regression && bun run test:chat && bun run test:exports && bun run test:extension && bun run test:tour && bun run test:legacy",
    "test:fast": "bun run build && bun run test:browsers && bun run test:static && bun run test:specs && bun run test:extension && bun run test:tour",
    "test:static": "node scripts/run-parallel.mjs typecheck=tsc_--noEmit lint=xo",
    "test:browsers": "playwright install chromium",
    "test:specs": "node scripts/run-parallel.mjs smoke=tsx_tests/smoke.spec.ts regression=tsx_tests/regression.spec.ts chat=tsx_tests/chat.spec.ts exports=tsx_tests/exports.spec.ts",
    "test:smoke": "tsx tests/smoke.spec.ts",
    "test:regression": "tsx tests/regression.spec.ts",
    "test:chat": "tsx tests/chat.spec.ts",
    "test:exports": "tsx tests/exports.spec.ts",
    "test:extension": "tsx tests/extension.spec.ts",
    "test:tour": "tsx tests/framework-tour.spec.ts",
    "test:legacy": "node --test tests/schema.test.mjs && node tests/replay.test.mjs && node tests/replay-auth.test.mjs && node --test tests/export.test.mjs && node --test tests/export-puppeteer.test.mjs && node --test tests/export-english.test.mjs && node --test tests/visual-diff.test.mjs && node --test tests/cross-browser.test.mjs && node --test tests/network-replay.test.mjs && node --test tests/annotator.test.mjs",
    "test:schema": "node --test tests/schema.test.mjs",
    "test:replay": "node tests/replay.test.mjs",
    "test:replay-auth": "node tests/replay-auth.test.mjs",
    "test:export": "node --test tests/export.test.mjs",
    "test:export-puppeteer": "node --test tests/export-puppeteer.test.mjs",
    "test:export-english": "node --test tests/export-english.test.mjs",
    "test:visual-diff": "node --test tests/visual-diff.test.mjs",
    "test:cross-browser": "node --test tests/cross-browser.test.mjs",
    "test:network-replay": "node --test tests/network-replay.test.mjs",
    "test:annotator": "node --test tests/annotator.test.mjs",
    "tour": "tsx tests/framework-tour.spec.ts",
    "devserver": "bun run scripts/static-server.ts",
    "install:extension": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-selector-capture-extension.ps1",
    "pinchtab:server": "npx pinchtab server --background",
    "pinchtab:status": "npx pinchtab health",
    "replay": "node bin/pinchgrab replay",
    "replay:multi": "node bin/replay-multi",
    "export:playwright": "node src/export-playwright.mjs",
    "export:puppeteer": "node src/export-puppeteer.mjs",
    "export:english": "node src/export-english.mjs",
    "visual-diff": "node src/visual-diff.mjs",
    "network-capture": "node src/network-capture.mjs",
    "annotator": "node src/annotator.mjs"
  },
  "bin": {
    "pinchgrab": "bin/pinchgrab"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/chrome": "^0.0.270",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pinchtab": "0.11.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "xo": "^0.60.0"
  },
  "xo": {
    "envs": ["browser", "node"],
    "extensions": ["ts"],
    "space": 2,
    "semicolon": true,
    "rules": {
      "unicorn/filename-case": "off",
      "unicorn/no-array-callback-reference": "off",
      "unicorn/prefer-dom-node-text-content": "off",
      "@typescript-eslint/naming-convention": "off",
      "n/prefer-global/process": "off",
      "import-x/extensions": "off",
      "@typescript-eslint/no-unsafe-assignment": "off",
      "@typescript-eslint/no-unsafe-member-access": "off",
      "@typescript-eslint/no-unsafe-call": "off",
      "@typescript-eslint/no-unsafe-return": "off",
      "@typescript-eslint/no-unsafe-argument": "off",
      "no-bitwise": "off",
      "max-depth": ["error", 6],
      "complexity": ["error", 80],
      "eqeqeq": ["error", "always", {
        "null": "ignore"
      }],
      "curly": "off",
      "@typescript-eslint/brace-style": "off",
      "brace-style": "off",
      "@typescript-eslint/padding-line-between-statements": "off",
      "padding-line-between-statements": "off",
      "padded-blocks": "off",
      "@typescript-eslint/object-curly-spacing": "off",
      "object-curly-spacing": "off",
      "object-curly-newline": "off",
      "array-element-newline": "off",
      "max-statements-per-line": "off",
      "arrow-parens": "off",
      "arrow-body-style": "off",
      "operator-linebreak": "off",
      "no-mixed-operators": "off",
      "no-multi-spaces": "off",
      "capitalized-comments": "off",
      "quotes": "off",
      "@typescript-eslint/quotes": "off",
      "semi": "off",
      "no-trailing-spaces": "off",
      "one-var": "off",
      "object-shorthand": "off",
      "import/order": "off",
      "import/no-duplicates": "off",
      "@typescript-eslint/consistent-type-imports": "off",
      "@typescript-eslint/consistent-type-definitions": "off",
      "@typescript-eslint/array-type": "off",
      "@typescript-eslint/member-ordering": "off",
      "@typescript-eslint/no-inferrable-types": "off",
      "@typescript-eslint/dot-notation": "off",
      "unicorn/prevent-abbreviations": "off",
      "unicorn/prefer-global-this": "off",
      "unicorn/catch-error-name": "off",
      "unicorn/explicit-length-check": "off",
      "unicorn/text-encoding-identifier-case": "off",
      "unicorn/number-literal-case": "off",
      "unicorn/no-array-push-push": "off",
      "unicorn/no-array-for-each": "off",
      "unicorn/no-process-exit": "off",
      "unicorn/no-negated-condition": "off",
      "unicorn/no-useless-fallback-in-spread": "off",
      "unicorn/no-useless-spread": "off",
      "unicorn/consistent-existence-index-check": "off",
      "unicorn/prefer-top-level-await": "off",
      "unicorn/prefer-string-replace-all": "off",
      "unicorn/prefer-string-starts-ends-with": "off",
      "unicorn/prefer-includes": "off",
      "unicorn/prefer-ternary": "off",
      "unicorn/prefer-switch": "off",
      "unicorn/switch-case-braces": "off",
      "unicorn/prefer-query-selector": "off",
      "unicorn/prefer-dom-node-dataset": "off",
      "unicorn/prefer-dom-node-append": "off",
      "unicorn/prefer-modern-dom-apis": "off",
      "unicorn/prefer-code-point": "off",
      "unicorn/prefer-at": "off",
      "unicorn/prefer-array-some": "off",
      "unicorn/prefer-keyboard-event-key": "off",
      "unicorn/prefer-reflect-apply": "off",
      "unicorn/prefer-native-coercion-functions": "off",
      "unicorn/prefer-optional-catch-binding": "off",
      "unicorn/import-style": "off",
      "@typescript-eslint/ban-types": "off",
      "@typescript-eslint/no-confusing-void-expression": "off",
      "@typescript-eslint/no-unnecessary-type-assertion": "off",
      "@typescript-eslint/non-nullable-type-assertion-style": "off",
      "@typescript-eslint/restrict-plus-operands": "off",
      "@typescript-eslint/prefer-nullish-coalescing": "off",
      "@typescript-eslint/prefer-optional-chain": "off",
      "@typescript-eslint/prefer-readonly": "off",
      "@typescript-eslint/prefer-includes": "off",
      "@typescript-eslint/prefer-for-of": "off",
      "@typescript-eslint/prefer-regexp-exec": "off",
      "@typescript-eslint/promise-function-async": "off",
      "@typescript-eslint/use-unknown-in-catch-callback-variable": "off",
      "@typescript-eslint/no-loop-func": "off",
      "@typescript-eslint/no-dynamic-delete": "off",
      "@typescript-eslint/no-unnecessary-boolean-literal-compare": "off",
      "@typescript-eslint/consistent-type-assertions": "off",
      "@typescript-eslint/switch-exhaustiveness-check": "off",
      "@typescript-eslint/require-array-sort-compare": "off",
      "@typescript-eslint/no-floating-promises": "off",
      "@typescript-eslint/no-unused-expressions": "off",
      "no-implicit-coercion": "off",
      "no-await-in-loop": "off",
      "no-var": "off",
      "no-void": "off",
      "no-useless-return": "off",
      "no-useless-escape": "off",
      "no-lonely-if": "off",
      "unicorn/no-lonely-if": "off",
      "no-unused-expressions": "off",
      "no-script-url": "off",
      "no-alert": "off",
      "no-restricted-globals": "off",
      "logical-assignment-operators": "off",
      "operator-assignment": "off",
      "new-cap": "off",
      "promise/param-names": "off",
      "unicorn/prefer-number-properties": "off",
      "unicorn/numeric-separators-style": "off",
      "unicorn/no-for-loop": "off",
      "unicorn/no-nested-ternary": "off",
      "unicorn/better-regex": "off",
      "one-var-declaration-per-line": "off",
      "no-eq-null": "off",
      "n/file-extension-in-import": "off",
      "no-promise-executor-return": "off",
      "@typescript-eslint/no-empty-function": "off",
      "@typescript-eslint/restrict-template-expressions": "off",
      "@typescript-eslint/prefer-string-starts-ends-with": "off",
      "@typescript-eslint/indent": "off",
      "import/extensions": "off",
      "no-return-await": "off",
      "unicorn/no-await-expression-member": "off",
      "unicorn/prefer-add-event-listener": "off"
    },
    "ignores": [
      "extension/**",
      "old/**",
      "demo/**",
      "dist/**",
      "node_modules/**",
      "lib/**",
      "src/templates.gen.ts",
      "tests/output/**",
      "tests/fixtures/**",
      "tests/_audit-export.mjs",
      "scripts/extract-export.mjs",
      "src/*.mjs",
      "tests/*.mjs",
      "bin/**"
    ]
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
