{
  "scripts": {
    "devserver": "node scripts/static-server.mjs",
    "build:bookmarklet": "node scripts/build-bookmarklet.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "install:extension": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-selector-capture-extension.ps1",
    "install:bookmarklet": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-selector-capture-bookmarklet.ps1",
    "pinchtab:server": "npx pinchtab server --background",
    "pinchtab:status": "npx pinchtab health",
    "test:schema": "node --test tests/schema.test.mjs",
    "test:replay": "node tests/replay.test.mjs",
    "test:replay-auth": "node tests/replay-auth.test.mjs",
    "test": "node --test tests/schema.test.mjs && node tests/replay.test.mjs && node tests/replay-auth.test.mjs",
    "replay": "node bin/pinchgrab replay"
  },
  "bin": {
    "pinchgrab": "bin/pinchgrab"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pinchtab": "0.11.0",
    "playwright": "^1.59.1"
  },
  "name": "pinchgrab"
}
