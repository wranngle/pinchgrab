{
  "manifest_version": 3,
  "name": "PinchGrab",
  "description": "Alt+Click DOM elements → structured selector + plain-text comments → JSONL hand-off for LLMs.",
  "version": "1.1.0",
  "homepage_url": "https://github.com/wranngle/pinchgrab",
  "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting", "contextMenus", "downloads", "downloads.ui", "downloads.shelf"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "PinchGrab — open side panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
